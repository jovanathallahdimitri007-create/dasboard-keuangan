# ==============================================================================
# ENVIRONMENT CONFIGURATION - DASHBOARD KEUANGAN KELAS & KORLAS
# ==============================================================================

# Supabase Online Database & Authentication (Optional / Production)
# Leave blank to use high-performance local SQLite database automatically
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=  # NEVER expose this on frontend or public repo

# Application Settings
APP_ENV=production
APP_DEFAULT_ROLE=bendahara  # Options: admin, korlas, bendahara, orang_tua
DEFAULT_ACADEMIC_YEAR=2026/2027
APPROVAL_THRESHOLD_IDR=1000000  # Transaksi pengeluaran di atas Rp 1.000.000 wajib persetujuan Korlas
